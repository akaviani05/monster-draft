[Unit]
Description=Monster Draft Duel web
After=network.target

[Service]
Type=simple
User=arena
Group=arena
WorkingDirectory=/opt/monster-duel
Environment=ARENA_DATA=/var/lib/monster-duel
Environment=ARENA_ORIGIN=https://arena.example.org
Environment=ARENA_SECURE_COOKIE=1
Environment=ARENA_TRUSTED_PROXIES=127.0.0.1
ExecStart=/usr/bin/python3 -m arena serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monster-duel
RestrictSUIDSGID=true
TasksMax=256
MemoryMax=3G

[Install]
WantedBy=multi-user.target
