[Unit]
Description=Monster Draft Duel isolated queue worker
After=network.target

[Service]
Type=simple
User=arena
Group=arena
WorkingDirectory=/opt/monster-duel
Environment=ARENA_DATA=/var/lib/monster-duel
ExecStart=/usr/bin/python3 -m arena worker --slots 6
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monster-duel
RestrictSUIDSGID=true
TasksMax=256
MemoryMax=4G

[Install]
WantedBy=multi-user.target
